{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
	"logo": {
		"type": "small",        // Logo type: auto, builtin, small, file, etc.
    	"source": "nixos",      // Built-in logo name or file path
    	"width": 40,           // Width in characters
    	"height": 20,          // Height in characters
    	"padding": {
        	"top": 0,          // Top padding
        	"left": 0,         // Left padding
        	"right": 2         // Right padding
    	}
	},
  "modules": [
    "title",
    "separator",
    "os",
    "uptime",
    "packages",
    "wm",
    "terminal",
    "cpu",
    "gpu",
    "memory",
    "disk",
    "localip",
    "battery",
    "poweradapter",
    "break"
//    "colors"
  ]
}
